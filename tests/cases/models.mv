# Small models, constructions and infinite spaces.
import models, topspaces, zoo

#! value 14
|AllGroups(8)|
#! value 46
|AllTopologies(4)|
#! value 3341
|AllMagmas(3)|

#! fails simplest ∅ on {1}
check forall R in AllRelations(3): symmetric_rel(R) and transitive_rel(R) -> reflexive_rel(R)
#! fails simplest S₃
check forall g in AllGroups(8): g in AbelianGroup
#! fails simplest ℤ/2 × ℤ/2 (Klein)
check forall g in AllGroups(8): g in AbelianGroup -> cyclic_group(g)
#! holds proved
check forall g in AllGroups(8): |g.G| in {2, 3, 5, 7} -> cyclic_group(g)
#! fails simplest operation [0 1 0 | 0 1 1 | 0 1 2] on {0, 1, 2}
check forall m in AllMagmas(3): associative(m.op, m.G) and has_identity(m.op, m.G) -> commutative(m.op, m.G)
#! fails simplest ({1, 2}, {∅, {1}, {1, 2}})
check forall S in AllTopologies(4): T0(S) -> T1(S)
#! holds proved
check forall f in AllMaps(3, 3): injective(f, 1..3) <-> surjective(f, 1..3, 1..3)
#! fails simplest poset on 2 points: no comparisons
check forall P in AllPosets(4): has_greatest(P)

# Built from pieces: 1_ℚ + (1 − 1_ℚ) = 1.
#! fails simplest Dirichlet function (1 on ℚ, 0 elsewhere) + (1 − Dirichlet function (1 on ℚ, 0 elsewhere))
check forall h in Sums(Famous): continuous_at(h, 1/2) -> continuous_at(h.left, 1/2) or continuous_at(h.right, 1/2)

# Infinite spaces by their known facts; finite ones computed.
#! fails simplest the line with two origins
check forall S in Spaces: T1(S) -> hausdorff_space(S)
#! fails simplest ℝ with the discrete topology
check forall S in Spaces: metrizable_space(S) -> separable_space(S)
#! fails simplest ({1, 2}, {∅, {1, 2}})
check forall S in Spaces: compact_space(S) -> hausdorff_space(S)
#! holds
check forall S in Spaces: (hausdorff_space(S) -> T1(S)) and (T1(S) -> T0(S))
#! error
T1(TopologicalSpace(R, {R}))
