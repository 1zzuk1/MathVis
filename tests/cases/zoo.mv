# The zoo: famous objects with exact facts.
import zoo

#! holds
check closed(CantorSet) and not open(CantorSet)
#! holds
check not open(Q) and not closed(Q)
#! value 0
measure(CantorSet)
#! value false
countable(CantorSet)
#! value 0.5
measure(FatCantor)
#! value true
countable(Q)
#! value 1
measure(Icc(0, 1))

#! holds
check forall a in [0, 1]: continuous_at(thomae, a) <-> not is_rational(a)
#! holds
check forall a in [0, 1]: not continuous_at(dirichlet, a)
#! value true
continuous_at(xQ, 0)
#! value false
continuous_at(xQ, 1/2)
#! value true
differentiable_at(x2Q, 0)
#! value false
differentiable_at(weierstrass, 0.3)
#! value true
integrable_on(thomae, 0, 1)
#! value false
integrable_on(dirichlet, 0, 1)
#! value true
integrable_on(indicator_cantor, 0, 1)
#! value false
differentiable_at(cantor_function, 1/3)
#! value true
differentiable_at(cantor_function, 1/2)

#! fails simplest the Cantor set
check forall S in FamousSets: measure(S) = 0 -> countable(S)
#! fails simplest the fat (Smith–Volterra–Cantor) set
check forall S in FamousSets: nowhere_dense(S) -> measure(S) = 0
#! fails simplest Weierstrass function Σ 2⁻ⁿcos(13ⁿπx)
check forall f in Famous: (forall a in [0, 1]: continuous_at(f, a)) -> (exists a in [0, 1]: differentiable_at(f, a))
#! fails simplest √2, −√2
check forall x in Irrationals, y in Irrationals: not is_rational(x + y)

# A notebook's own definition with a library name gets no facts: it is sampled.
def continuous_at(f, a) := true
#! value true
continuous_at(dirichlet, 1/2)
